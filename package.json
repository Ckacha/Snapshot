    "search": "node src/cli.js search"
  },
  "dependencies": {
    "@slack/socket-mode": "^2.0.2",
    "@slack/web-api": "^7.8.0",
    "dotenv": "^16.4.5",
    "emoji-datasource": "^16.0.0"
  }
}
